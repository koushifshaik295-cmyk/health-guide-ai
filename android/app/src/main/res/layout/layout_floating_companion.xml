<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!-- "I Drank" Card directly above character -->
    <LinearLayout
        android:id="@+id/card_drank_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0C1B17"
        android:padding="12dp"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="70 mins done! Take a sip! 💧"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_overlay_drank"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="I Drank ✓"
            android:textColor="#080C0D"
            android:textStyle="bold"
            android:background="#00E676" />
    </LinearLayout>

    <!-- Animated Character Image -->
    <ImageView
        android:id="@+id/img_overlay_hero"
        android:layout_width="160dp"
        android:layout_height="220dp"
        android:contentDescription="Drinking Companion"
        android:scaleType="fitCenter" />
</LinearLayout>